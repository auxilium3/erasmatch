# Copy to .env and adjust. Every setting can also be passed as an environment variable.

# memory:// (no database) or a PostgreSQL URL
ERASMATCH_DATABASE_URL=postgresql+psycopg://erasmatch:erasmatch@localhost:5432/erasmatch

# Embeddings: ollama | openai | hashing (offline, not semantic, for tests)
ERASMATCH_EMBEDDER=ollama
ERASMATCH_EMBEDDING_MODEL=bge-m3
ERASMATCH_EMBEDDING_DIM=1024

# LLM for explanations and PDF extraction: ollama | openai | none
ERASMATCH_LLM=ollama
ERASMATCH_LLM_MODEL=qwen2.5:7b-instruct
ERASMATCH_EXPLANATION_LANGUAGE=en

ERASMATCH_OLLAMA_URL=http://localhost:11434
# ERASMATCH_OPENAI_BASE_URL=https://api.openai.com/v1
# ERASMATCH_OPENAI_API_KEY=

# Matching (leave ERASMATCH_TOPIC_THRESHOLD unset to use the embedder's default)
# ERASMATCH_TOPIC_THRESHOLD=0.6
# ERASMATCH_MIN_ECTS_RATIO=1.0
# ERASMATCH_TARGET_COVERAGE=0.75
# ERASMATCH_MIN_COVERAGE=0.5
